WASTE_API_URL=http://127.0.0.1:8000
# For Streamlit Community Cloud, set this to your deployed Render API URL.
# WASTE_API_URL=https://your-ecotrack-api.onrender.com

# Local development default (omit DATABASE_URL to use backend/waste_management.db)
# DATABASE_URL=sqlite:///./backend/waste_management.db

# Cloud deployment: set this in the Render service environment using the Neon URL.
# Use the private connection URL and keep its password in the hosting provider's
# environment settings. Never commit a real credential to this file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Comma-separated browser origins allowed to call the API.
# Keep localhost origins for local Streamlit development and add the deployed
# Streamlit Community Cloud origin in Render, for example:
# CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://your-ecotrack-app.streamlit.app
